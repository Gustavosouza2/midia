# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# Nenhuma destas variáveis usa o prefixo NEXT_PUBLIC_: todas ficam só no servidor.

# Conexão de servidor com o Postgres do Supabase (pooler em modo transação, porta 6543).
# Supabase > Project Settings > Database > Connection string > Transaction pooler.
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"

# Opcional. Slug da cantina atendida por este deploy (padrão: midia).
CANTINA_SLUG="midia"
